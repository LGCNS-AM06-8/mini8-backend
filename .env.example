# 이 파일을 프로젝트 루트에 .env 로 복사해서 값을 채웁니다. .env 는 커밋하지 않습니다.
# 이름은 application-dev.yml 이 읽는 것과 1대1로 맞춥니다.

# DB (MariaDB 11.x. 먼저 CREATE DATABASE mini8 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
DB_URL=jdbc:mariadb://localhost:3306/mini8
DB_USER=root
DB_PASSWORD=

# JWT 서명 키 (32바이트 이상 아무 문자열)
JWT_SECRET=

# 외부 서비스. 값이 아직 없어도 줄은 지우지 않습니다 (이름이 없으면 서버가 뜨지 않습니다)
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
